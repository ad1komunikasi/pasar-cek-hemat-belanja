# Salin ke .env.local lalu isi. Jangan commit file berisi nilai asli.

# Supabase (wajib)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — hanya server, untuk operasi admin
SUPABASE_SERVICE_ROLE_KEY=

# Login Google (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=

# Peta Google (opsional — tanpa ini memakai Leaflet)
VITE_GOOGLE_MAPS_API_KEY=

# Fitur AI (Gemini)
GEMINI_API_KEY=

# Email transaksional (Resend)
VITE_RESEND_API_KEY=
